<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HausaNovels.App" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/hn_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/hn_green</item>
        <item name="android:statusBarColor">@color/hn_background</item>
        <item name="android:navigationBarColor">@color/hn_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowSplashScreenBackground">@color/hn_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/hausanovels_splash_icon</item>
    </style>

    <style name="Theme.HausaNovels.TWA" parent="Theme.HausaNovels.App" />
    <style name="Theme.HausaNovels.Splash" parent="Theme.HausaNovels.App" />
    <style name="Theme.HausaNovels.OAuthReturn" parent="Theme.HausaNovels.App" />
</resources>
